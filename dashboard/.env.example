# URL where the verifier publishes issue-results.json.
# After you add a GitHub remote and the workflow pushes to a `data` branch,
# this becomes: https://raw.githubusercontent.com/<owner>/<repo>/data/issue-results.json
#
# Tip: the dashboard fetches this server-side and re-validates every 60s.
DATA_URL=https://raw.githubusercontent.com/REPLACE_ME/REPLACE_ME/data/issue-results.json

# URL where verify-scenarios.js publishes scenario-results.json. Same pattern
# as DATA_URL above. The dashboard simply omits the Workflow Scenarios
# section when this URL is unreachable or unset.
SCENARIOS_DATA_URL=https://raw.githubusercontent.com/REPLACE_ME/REPLACE_ME/data/scenario-results.json

# URL where the verifier publishes routes.status.json — the per-route
# merged verdict (HTTP probe + browser load) from verify/report.js.
# Powers the "Route Health" section. Same pattern as the URLs above;
# the section is silently omitted when this URL is unset or unreachable.
ROUTES_DATA_URL=https://raw.githubusercontent.com/REPLACE_ME/REPLACE_ME/data/routes.status.json
