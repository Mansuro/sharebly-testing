{
  "name": "sharebly-route-verifier",
  "version": "1.0.0",
  "description": "Verify Sharebly routes against running dev server",
  "type": "module",
  "scripts": {
    "verify:http": "node verify-http.js",
    "verify:browser": "node verify-browser.js",
    "verify:all": "node verify-http.js && node verify-browser.js",
    "report": "node report.js",
    "calibrate": "node calibrate.js",
    "crawl": "node crawl.js",
    "extract": "node extract-routes.js",
    "apply-bundle": "node apply-bundle.js",
    "apply-bundle:force": "node apply-bundle.js --apply",
    "merge-orphans": "node merge-orphans.js",
    "merge-orphans:force": "node merge-orphans.js --apply",
    "triage": "node triage.js",
    "triage:force": "node triage.js --apply",
    "apply": "node apply.js",
    "apply:force": "node apply.js --apply"
  },
  "dependencies": {
    "playwright": "^1.48.0"
  }
}
